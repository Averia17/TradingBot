{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research job HTTP protocols 0.1 to 0.3",
  "$ref": "#/$defs/SupportedJobRequest",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "JobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_schema_version", "job_id", "portfolio", "requested_symbols", "data_manifest", "policy_version", "max_llm_calls"],
      "properties": {
        "job_schema_version": {"const": "0.1"},
        "job_id": {"$ref": "#/$defs/UUID"},
        "portfolio": {"$ref": "portfolio.schema.json"},
        "requested_symbols": {
          "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$"}
        },
        "data_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "sha256"],
          "properties": {
            "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "policy_version": {"$ref": "#/$defs/Identifier"},
        "max_llm_calls": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "PinnedLocalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$",
          "not": {"pattern": "(^|/)([.]|[.][.])(/|$)|//|/$"}
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "SecurityBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "description": "One distinct security ID for each requested symbol, in requested_symbols order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "security_id"],
        "properties": {
          "symbol": {"$ref": "#/$defs/JobRequest/properties/requested_symbols/items"},
          "security_id": {"$ref": "#/$defs/Identifier"}
        }
      }
    },
    "IdentityJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_schema_version", "job_id", "portfolio", "requested_symbols", "data_manifest", "policy_version", "max_llm_calls", "identity_registry", "security_bindings"],
      "properties": {
        "job_schema_version": {"const": "0.2"},
        "job_id": {"$ref": "#/$defs/JobRequest/properties/job_id"},
        "portfolio": {"$ref": "#/$defs/JobRequest/properties/portfolio"},
        "requested_symbols": {"$ref": "#/$defs/JobRequest/properties/requested_symbols"},
        "data_manifest": {"$ref": "#/$defs/PinnedLocalReference"},
        "policy_version": {"$ref": "#/$defs/JobRequest/properties/policy_version"},
        "max_llm_calls": {"$ref": "#/$defs/JobRequest/properties/max_llm_calls"},
        "identity_registry": {"$ref": "#/$defs/PinnedLocalReference"},
        "security_bindings": {"$ref": "#/$defs/SecurityBindings"}
      }
    },
    "ProviderJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_schema_version", "analysis_mode", "job_id", "portfolio", "requested_symbols", "data_manifest", "policy_version", "max_llm_calls", "identity_registry", "security_bindings"],
      "properties": {
        "job_schema_version": {"const": "0.3"},
        "analysis_mode": {"const": "prepared_provider"},
        "job_id": {"$ref": "#/$defs/IdentityJobRequest/properties/job_id"},
        "portfolio": {"$ref": "#/$defs/IdentityJobRequest/properties/portfolio"},
        "requested_symbols": {"$ref": "#/$defs/IdentityJobRequest/properties/requested_symbols"},
        "data_manifest": {"$ref": "#/$defs/PinnedLocalReference"},
        "policy_version": {"$ref": "#/$defs/IdentityJobRequest/properties/policy_version"},
        "max_llm_calls": {"const": 1},
        "identity_registry": {"$ref": "#/$defs/PinnedLocalReference"},
        "security_bindings": {"$ref": "#/$defs/SecurityBindings"}
      }
    },
    "IdentityJobs": {
      "oneOf": [
        {"$ref": "#/$defs/IdentityJobRequest"},
        {"$ref": "#/$defs/ProviderJobRequest"}
      ]
    },
    "SupportedJobRequest": {
      "oneOf": [
        {"$ref": "#/$defs/JobRequest"},
        {"$ref": "#/$defs/IdentityJobs"}
      ]
    },
    "ClaimRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "claim_id"],
      "properties": {
        "worker_id": {"$ref": "#/$defs/Identifier"},
        "claim_id": {"$ref": "#/$defs/UUID"},
        "identity_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "analysis_mode": {"const": "prepared_provider"}
      },
      "dependentRequired": {"analysis_mode": ["identity_registry_sha256"]}
    },
    "HeartbeatRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "lease_token"],
      "properties": {
        "worker_id": {"$ref": "#/$defs/Identifier"},
        "lease_token": {"$ref": "#/$defs/UUID"}
      }
    },
    "AuthorizeCallRequest": {
      "description": "Request one durable call permit before invoking the model. Retry the same call ID and lease after an uncertain response.",
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "lease_token", "call_id"],
      "properties": {
        "worker_id": {"$ref": "#/$defs/Identifier"},
        "lease_token": {"$ref": "#/$defs/UUID"},
        "call_id": {"$ref": "#/$defs/UUID"}
      }
    },
    "AuthorizeCallResponse": {
      "description": "One committed permit for the active attempt. An identical retry on the same active lease returns the original receipt.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "call_id", "attempt", "remaining_llm_calls"],
      "properties": {
        "job_id": {"$ref": "#/$defs/UUID"},
        "call_id": {"$ref": "#/$defs/UUID"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "remaining_llm_calls": {
          "type": "integer", "minimum": 0, "maximum": 63,
          "description": "Job budget remaining immediately after this grant. Later grants may reduce the current balance."
        }
      }
    },
    "Lease": {
      "type": "object",
      "required": ["job_id", "status", "worker_id", "claim_id", "lease_token", "attempt", "lease_expires_at", "attempt_deadline"],
      "properties": {
        "job_id": {"$ref": "#/$defs/UUID"},
        "status": {"const": "leased"},
        "worker_id": {"$ref": "#/$defs/Identifier"},
        "claim_id": {"$ref": "#/$defs/UUID"},
        "lease_token": {"$ref": "#/$defs/UUID"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "lease_expires_at": {"type": "string", "format": "date-time"},
        "attempt_deadline": {"type": "string", "format": "date-time"}
      }
    },
    "ClaimResponse": {
      "allOf": [{"$ref": "#/$defs/Lease"}],
      "properties": {"request": {"$ref": "#/$defs/SupportedJobRequest"}},
      "required": ["request"],
      "unevaluatedProperties": false
    },
    "HeartbeatResponse": {
      "allOf": [{"$ref": "#/$defs/Lease"}],
      "unevaluatedProperties": false
    }
  }
}
