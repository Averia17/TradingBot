{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linear perpetual entry study for a flat virtual account",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_mode", "as_of", "horizon_hours", "available_collateral_usd", "policy", "markets"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source_mode": {"enum": ["synthetic_fixture", "observed_market"]},
    "as_of": {"type": "string", "format": "date-time"},
    "horizon_hours": {"type": "integer", "minimum": 1, "maximum": 720},
    "available_collateral_usd": {"$ref": "#/$defs/Amount"},
    "policy": {"$ref": "#/$defs/Policy"},
    "markets": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"$ref": "#/$defs/Market"}
    }
  },
  "$defs": {
    "Amount": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$"},
    "BasisPoints": {"type": "integer", "minimum": 0, "maximum": 10000},
    "Id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_leverage", "max_notional_usd", "max_stress_loss_usd", "max_quote_age_seconds", "max_mark_basis_bps", "min_mark_stress_bps", "maintenance_buffer_bps", "min_net_edge_bps"],
      "properties": {
        "allowed_leverage": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 100}
        },
        "max_notional_usd": {"$ref": "#/$defs/Amount"},
        "max_stress_loss_usd": {"$ref": "#/$defs/Amount"},
        "max_quote_age_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_mark_basis_bps": {"$ref": "#/$defs/BasisPoints"},
        "min_mark_stress_bps": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maintenance_buffer_bps": {"type": "integer", "minimum": 1, "maximum": 10000},
        "min_net_edge_bps": {"$ref": "#/$defs/BasisPoints"}
      }
    },
    "Market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_id", "security_id", "symbol", "product", "observation_id", "observed_at", "available_at", "mark_usd", "index_usd", "mark_stress_bps", "quotes"],
      "properties": {
        "market_id": {"$ref": "#/$defs/Id"},
        "security_id": {"$ref": "#/$defs/Id"},
        "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$"},
        "product": {"const": "linear_usd_isolated_perpetual"},
        "observation_id": {"$ref": "#/$defs/Id"},
        "observed_at": {"type": "string", "format": "date-time"},
        "available_at": {"type": "string", "format": "date-time"},
        "mark_usd": {"$ref": "#/$defs/Amount"},
        "index_usd": {"$ref": "#/$defs/Amount"},
        "mark_stress_bps": {"$ref": "#/$defs/BasisPoints"},
        "quotes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/Quote"}}
      }
    },
    "Quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notional_usd", "venue_max_leverage", "maintenance_margin_bps", "long", "short"],
      "properties": {
        "notional_usd": {"$ref": "#/$defs/Amount"},
        "venue_max_leverage": {"type": "integer", "minimum": 1, "maximum": 100},
        "maintenance_margin_bps": {"type": "integer", "minimum": 1, "maximum": 10000},
        "long": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Costs"}]},
        "short": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Costs"}]}
      }
    },
    "Costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_trip_execution_bps", "projected_funding_cost_bps", "funding_stress_cost_bps"],
      "properties": {
        "round_trip_execution_bps": {"$ref": "#/$defs/BasisPoints"},
        "projected_funding_cost_bps": {"type": "integer", "minimum": -10000, "maximum": 10000},
        "funding_stress_cost_bps": {"$ref": "#/$defs/BasisPoints"}
      }
    }
  }
}
