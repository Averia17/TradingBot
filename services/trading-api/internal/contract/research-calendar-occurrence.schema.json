{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingbot.local/research-calendar-occurrence.schema.json",
  "$defs": {
    "Fields": {
      "type": "object",
      "required": ["schema_version", "schedule_id", "scheduled_at", "max_lateness_seconds", "request_sha256"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "schedule_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "scheduled_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "max_lateness_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "Occurrence": {
      "$ref": "#/$defs/Fields",
      "unevaluatedProperties": false
    },
    "Receipt": {
      "$ref": "#/$defs/Fields",
      "required": ["job_id", "recorded_at", "status"],
      "properties": {
        "job_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "recorded_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "status": {"enum": ["missed", "job_recorded", "job_conflict"]},
        "job_created_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
      },
      "if": {"properties": {"status": {"const": "missed"}}},
      "then": {"not": {"required": ["job_created_at"]}},
      "else": {"required": ["job_created_at"]},
      "unevaluatedProperties": false
    }
  }
}
