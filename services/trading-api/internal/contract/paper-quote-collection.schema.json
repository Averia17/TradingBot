{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local synthetic paper quote collection 0.1",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Mint": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "Config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_quote_collection_schema_version", "account_id", "identity_registry_sha256", "cash_mint", "requests"],
      "properties": {
        "paper_quote_collection_schema_version": {"const": "0.1"},
        "account_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "identity_registry_sha256": {"$ref": "paper-replay.schema.json#/$defs/SHA256"},
        "cash_mint": {"$ref": "#/$defs/Mint", "description": "Owner fixture identity for the six-decimal USDC used as USD in the virtual account."},
        "requests": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"$ref": "#/$defs/Request"}}
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security_id", "instrument", "token_mint", "side", "amount_raw"],
      "properties": {
        "security_id": {"$ref": "paper-replay.schema.json#/$defs/SecurityID"},
        "instrument": {"$ref": "paper-account.schema.json#/$defs/Instrument"},
        "token_mint": {"$ref": "#/$defs/Mint", "description": "Owner-selected mint label for the local response fixture."},
        "side": {"$ref": "paper-replay.schema.json#/$defs/Side"},
        "amount_raw": {"$ref": "paper-replay.schema.json#/$defs/Quantity", "description": "Exact raw input amount: USDC for a buy or the token for a sell."}
      }
    },
    "FixtureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_quote_fixture_schema_version", "input_mint", "output_mint", "in_amount"],
      "properties": {
        "paper_quote_fixture_schema_version": {"const": "0.1"},
        "input_mint": {"$ref": "#/$defs/Mint"},
        "output_mint": {"$ref": "#/$defs/Mint"},
        "in_amount": {"$ref": "paper-replay.schema.json#/$defs/Quantity"}
      }
    },
    "FixtureResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_quote_fixture_schema_version", "input_mint", "output_mint", "in_amount", "out_amount", "min_out_amount", "observed_at", "available_at", "expires_at", "fee_bps", "fixed_fee_usd"],
      "properties": {
        "paper_quote_fixture_schema_version": {"const": "0.1"},
        "input_mint": {"$ref": "#/$defs/Mint"},
        "output_mint": {"$ref": "#/$defs/Mint"},
        "in_amount": {"$ref": "paper-replay.schema.json#/$defs/Quantity"},
        "out_amount": {"$ref": "paper-replay.schema.json#/$defs/Quantity"},
        "min_out_amount": {"$ref": "paper-replay.schema.json#/$defs/Quantity"},
        "observed_at": {"type": "string", "format": "date-time"},
        "available_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "fee_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "fixed_fee_usd": {"$ref": "paper-account.schema.json#/$defs/USD"}
      }
    }
  }
}
