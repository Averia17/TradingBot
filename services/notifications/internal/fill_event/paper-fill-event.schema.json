{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingBot paper ledger fill notification 1.1",
  "description": "One committed paper ledger fill. USD amounts and raw units are exact. The notice ID is paper:<account_id>:<fill_event_id>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "mode", "source", "account_id", "order_id", "decision_id", "quote_id", "fill_event_id",
    "instrument_id", "registry_version", "decimals", "side", "quantity_raw", "gross_usd", "fee_usd", "currency",
    "filled_at", "recorded_at"
  ],
  "properties": {
    "version": {"const": "1.1"},
    "id": {"type": "string", "pattern": "^paper:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
    "mode": {"const": "paper"},
    "source": {"const": "paper_ledger"},
    "account_id": {"$ref": "#/$defs/UUID"},
    "order_id": {"$ref": "#/$defs/UUID"},
    "decision_id": {"$ref": "#/$defs/UUID"},
    "quote_id": {"$ref": "#/$defs/UUID"},
    "research_job_id": {"$ref": "#/$defs/UUID"},
    "fill_event_id": {"$ref": "#/$defs/UUID"},
    "instrument_id": {"$ref": "#/$defs/InstrumentPart"},
    "registry_version": {"$ref": "#/$defs/InstrumentPart"},
    "decimals": {"type": "integer", "minimum": 0, "maximum": 18},
    "side": {"enum": ["BUY", "SELL"]},
    "quantity_raw": {"type": "string", "pattern": "^[1-9][0-9]{0,37}$"},
    "gross_usd": {"$ref": "#/$defs/USD", "not": {"pattern": "^0(?:\\.0+)?$"}},
    "fee_usd": {"$ref": "#/$defs/USD"},
    "currency": {"const": "USD"},
    "filled_at": {"$ref": "#/$defs/UTCTimestamp"},
    "recorded_at": {"$ref": "#/$defs/UTCTimestamp"}
  },
  "$defs": {
    "UUID": {"type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
    "InstrumentPart": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$"},
    "USD": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,29})(?:\\.[0-9]{1,8})?$"},
    "UTCTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    }
  }
}
