{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic paper fixture replay 0.1 and 0.2",
  "$ref": "#/$defs/Result",
  "$defs": {
    "SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Quantity": {"type": "string", "pattern": "^[1-9][0-9]{0,37}$"},
    "Side": {"enum": ["BUY", "SELL"]},
    "Execution": {"enum": ["fill", "reject", "timeout", "partial"]},
    "Intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_intent_schema_version", "account_id", "decision_id", "snapshot_version", "instrument", "side", "quantity_raw", "gross_limit_usd", "max_fee_usd", "decided_at", "expires_at", "quote_sha256"],
      "properties": {
        "paper_intent_schema_version": {"const": "0.1"},
        "account_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "decision_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "snapshot_version": {"type": "integer", "minimum": 1},
        "instrument": {"$ref": "paper-account.schema.json#/$defs/Instrument"},
        "side": {"$ref": "#/$defs/Side"},
        "quantity_raw": {"$ref": "#/$defs/Quantity"},
        "gross_limit_usd": {"$ref": "paper-account.schema.json#/$defs/USD"},
        "max_fee_usd": {"$ref": "paper-account.schema.json#/$defs/USD"},
        "decided_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "quote_sha256": {"$ref": "#/$defs/SHA256", "description": "Hash of the exact quote file bytes."}
      }
    },
    "Quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_quote_schema_version", "source_mode", "instrument", "side", "quantity_raw", "gross_usd", "fee_bps", "fixed_fee_usd", "observed_at", "expires_at", "execution"],
      "properties": {
        "paper_quote_schema_version": {"enum": ["0.1", "0.2"]},
        "source_mode": {"const": "synthetic_fixture"},
        "instrument": {"$ref": "paper-account.schema.json#/$defs/Instrument"},
        "side": {"$ref": "#/$defs/Side"},
        "quantity_raw": {"$ref": "#/$defs/Quantity"},
        "executed_quantity_raw": {"$ref": "#/$defs/Quantity", "description": "Simulated fill portion of the quoted whole order."},
        "gross_usd": {"$ref": "paper-account.schema.json#/$defs/USD"},
        "fee_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "fixed_fee_usd": {"$ref": "paper-account.schema.json#/$defs/USD"},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "execution": {"$ref": "#/$defs/Execution"}
      },
      "if": {"properties": {"paper_quote_schema_version": {"const": "0.2"}}},
      "then": {"required": ["executed_quantity_raw"], "properties": {"execution": {"const": "partial"}}},
      "else": {"not": {"required": ["executed_quantity_raw"]}, "properties": {"execution": {"enum": ["fill", "reject", "timeout"]}}}
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_replay_schema_version", "source_mode", "quote_sha256", "simulated_execution", "reservation_recorded", "outcome_recorded", "order"],
      "properties": {
        "paper_replay_schema_version": {"enum": ["0.1", "0.2"]},
        "source_mode": {"const": "synthetic_fixture"},
        "quote_sha256": {"$ref": "#/$defs/SHA256"},
        "simulated_execution": {"$ref": "#/$defs/Execution"},
        "reservation_recorded": {"type": "boolean"},
        "outcome_recorded": {"type": "boolean"},
        "order": {"$ref": "paper-account.schema.json#/$defs/Order"}
      },
      "if": {"properties": {"paper_replay_schema_version": {"const": "0.2"}}},
      "then": {"properties": {"simulated_execution": {"const": "partial"}}},
      "else": {"properties": {"simulated_execution": {"enum": ["fill", "reject", "timeout"]}}}
    }
  }
}
