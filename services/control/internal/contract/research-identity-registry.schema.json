{
  "$defs": {
    "PaperInstrument": {
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "registry_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$",
          "title": "Registry Version",
          "type": "string"
        },
        "decimals": {
          "maximum": 18,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        }
      },
      "required": [
        "instrument_id",
        "registry_version",
        "decimals"
      ],
      "title": "PaperInstrument",
      "type": "object"
    },
    "RegistryEntry": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$",
          "title": "Symbol",
          "type": "string"
        },
        "security_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Security Id",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Available At",
          "type": "string"
        },
        "effective_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Effective At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "record_providers": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Record Providers",
          "type": "array"
        },
        "sec_cik": {
          "anyOf": [
            {
              "pattern": "^[0-9]{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sec Cik"
        },
        "instrument": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperInstrument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "symbol",
        "security_id",
        "available_at",
        "effective_at",
        "record_providers"
      ],
      "title": "RegistryEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "universe_provider": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Universe Provider",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "universe_provider",
    "entries"
  ],
  "title": "SecurityRegistry",
  "type": "object"
}
