{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inputs for an equity route study compiled from archived market observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_mode",
    "as_of",
    "horizon_hours",
    "max_skew_seconds",
    "account",
    "policy",
    "securities"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "source_mode": {
      "enum": [
        "synthetic_fixture",
        "observed_market"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "horizon_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 720
    },
    "max_skew_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "account": {
      "$ref": "equity-route-study.schema.json#/$defs/Account"
    },
    "policy": {
      "$ref": "equity-route-study.schema.json#/$defs/Policy"
    },
    "securities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/Security"
      }
    }
  },
  "$defs": {
    "Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,20})?$"
    },
    "Security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security_id",
        "symbol",
        "held_spot",
        "corporate_action_window_clear",
        "market_stress_down_bps",
        "market_stress_up_bps",
        "reference",
        "notionals_usd",
        "spot",
        "perp"
      ],
      "properties": {
        "security_id": {
          "$ref": "equity-route-study.schema.json#/$defs/Id"
        },
        "symbol": {
          "$ref": "equity-route-study.schema.json#/$defs/Symbol"
        },
        "held_spot": {
          "anyOf": [
            {
              "$ref": "equity-route-study.schema.json#/$defs/HeldSpot"
            },
            {
              "type": "null"
            }
          ]
        },
        "corporate_action_window_clear": {
          "type": "boolean"
        },
        "market_stress_down_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "market_stress_up_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price_usd",
            "observed_at",
            "available_at",
            "evidence_sha256"
          ],
          "properties": {
            "price_usd": {
              "$ref": "#/$defs/Decimal"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "available_at": {
              "type": "string",
              "format": "date-time"
            },
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "notionals_usd": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "equity-route-study.schema.json#/$defs/Amount"
          }
        },
        "spot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Spot"
            },
            {
              "type": "null"
            }
          ]
        },
        "perp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Perp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Spot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_id",
        "shares_per_unit",
        "usd_per_quote_unit",
        "taker_fee_bps",
        "fixed_fee_usd_per_leg",
        "execution_stress_add_bps",
        "basis_cost_bps",
        "basis_stress_bps",
        "provider",
        "market_symbol",
        "size_decimals",
        "order_book"
      ],
      "properties": {
        "market_id": {
          "$ref": "equity-route-study.schema.json#/$defs/Id"
        },
        "shares_per_unit": {
          "$ref": "#/$defs/Decimal"
        },
        "usd_per_quote_unit": {
          "$ref": "#/$defs/Decimal"
        },
        "taker_fee_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "fixed_fee_usd_per_leg": {
          "$ref": "#/$defs/Decimal"
        },
        "execution_stress_add_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "basis_cost_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "basis_stress_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "provider": {
          "enum": [
            "dzengi",
            "binance"
          ]
        },
        "market_symbol": {
          "$ref": "equity-route-study.schema.json#/$defs/Symbol"
        },
        "size_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "order_book": {
          "$ref": "venue-order-book.schema.json#/$defs/OrderBook"
        }
      }
    },
    "Perp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_id",
        "shares_per_unit",
        "usd_per_quote_unit",
        "taker_fee_bps",
        "fixed_fee_usd_per_leg",
        "execution_stress_add_bps",
        "basis_cost_bps",
        "basis_stress_bps",
        "external_session_until",
        "funding_stress_rate_hourly",
        "collateral_token_index",
        "capture"
      ],
      "properties": {
        "market_id": {
          "$ref": "equity-route-study.schema.json#/$defs/Id"
        },
        "shares_per_unit": {
          "$ref": "#/$defs/Decimal"
        },
        "usd_per_quote_unit": {
          "$ref": "#/$defs/Decimal"
        },
        "taker_fee_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "fixed_fee_usd_per_leg": {
          "$ref": "#/$defs/Decimal"
        },
        "execution_stress_add_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "basis_cost_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "basis_stress_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "external_session_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "funding_stress_rate_hourly": {
          "$ref": "#/$defs/Decimal"
        },
        "collateral_token_index": {
          "type": "integer",
          "minimum": 0
        },
        "capture": {
          "type": "object",
          "required": [
            "schema_version",
            "provider",
            "dex",
            "coin",
            "available_at",
            "meta_response",
            "book_response"
          ],
          "properties": {
            "schema_version": {
              "const": "0.1"
            },
            "provider": {
              "const": "hyperliquid"
            },
            "dex": {
              "const": "xyz"
            },
            "coin": {
              "type": "string",
              "pattern": "^xyz:[A-Z][A-Z0-9.\\-]{0,15}$"
            },
            "available_at": {
              "type": "string",
              "format": "date-time"
            },
            "meta_response": {
              "$ref": "#/$defs/RawResponse"
            },
            "book_response": {
              "$ref": "#/$defs/RawResponse"
            }
          }
        }
      }
    },
    "RawResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_at",
        "received_at",
        "sha256",
        "body_base64"
      ],
      "properties": {
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "body_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 4
        }
      }
    }
  }
}
