{
  "$defs": {
    "ALFREDCapture": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "alfred_observations",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "series_id": {
          "pattern": "^[A-Z0-9][A-Z0-9_]{0,59}$",
          "title": "Series Id",
          "type": "string"
        },
        "vintage_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Vintage Date",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "captured_at",
        "series_id",
        "vintage_date"
      ],
      "title": "ALFREDCapture",
      "type": "object"
    },
    "ArchiveReference": {
      "additionalProperties": false,
      "description": "Reference shape shared with the research job's data_manifest field.",
      "properties": {
        "ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$",
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "title": "ArchiveReference",
      "type": "object"
    },
    "BLSCapture": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bls_release_review",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "reviewed_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Reviewed At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "reviewed_at"
      ],
      "title": "BLSCapture",
      "type": "object"
    },
    "MarketCapture": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "normalized_market",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "captured_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Captured At",
          "type": "string"
        },
        "provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "captured_at",
        "provider"
      ],
      "title": "MarketCapture",
      "type": "object"
    },
    "SECCapture": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sec_submissions",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "cik": {
          "pattern": "^[0-9]{10}$",
          "title": "Cik",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$",
          "title": "Symbol",
          "type": "string"
        },
        "accessions": {
          "items": {
            "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Accessions",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "source",
        "captured_at",
        "cik",
        "symbol",
        "accessions"
      ],
      "title": "SECCapture",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_mode": {
      "enum": [
        "synthetic_fixture",
        "local_archive"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "captures": {
      "items": {
        "discriminator": {
          "mapping": {
            "alfred_observations": "#/$defs/ALFREDCapture",
            "bls_release_review": "#/$defs/BLSCapture",
            "normalized_market": "#/$defs/MarketCapture",
            "sec_submissions": "#/$defs/SECCapture"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SECCapture"
          },
          {
            "$ref": "#/$defs/ALFREDCapture"
          },
          {
            "$ref": "#/$defs/BLSCapture"
          },
          {
            "$ref": "#/$defs/MarketCapture"
          }
        ]
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Captures",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_mode",
    "captures"
  ],
  "title": "CaptureManifest",
  "type": "object"
}
