            "$ref": "#/$defs/MarketBar"
          },
          {
            "$ref": "#/$defs/MarketNews"
          },
          {
            "$ref": "#/$defs/MarketAction"
          },
          {
            "$ref": "#/$defs/MarketListing"
          }
        ]
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "title": "MarketResponse",
  "type": "object"
