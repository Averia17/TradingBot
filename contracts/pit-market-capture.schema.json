{
  "$defs": {
    "Listing": {
      "additionalProperties": false,
      "properties": {
        "security_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Security Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "listed",
            "delisted"
          ],
          "title": "Status",
          "type": "string"
        },
        "effective_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Effective At",
          "type": "string"
        }
      },
      "required": [
        "security_id",
        "status",
        "effective_at"
      ],
      "title": "Listing",
      "type": "object"
    },
    "MarketAction": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$",
          "title": "Symbol",
          "type": "string"
        },
        "revision": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "event_time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Event Time",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Available At",
          "type": "string"
        },
        "kind": {
          "const": "action",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "cash_dividend": "#/$defs/_CashDividend",
              "split": "#/$defs/_StockSplit"
            },
            "propertyName": "action"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/_StockSplit"
            },
            {
              "$ref": "#/$defs/_CashDividend"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "record_id",
        "symbol",
        "revision",
        "event_time",
        "available_at",
        "kind",
        "payload"
      ],
      "title": "MarketAction",
      "type": "object"
    },
