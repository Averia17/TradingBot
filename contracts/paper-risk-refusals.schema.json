{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper risk refusals 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_mode", "account_id", "job_id", "as_of", "truncated", "refusals"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source_mode": {"const": "synthetic_fixture"},
    "account_id": {"$ref": "#/$defs/UUID"},
    "job_id": {"$ref": "#/$defs/UUID"},
    "as_of": {"$ref": "#/$defs/Timestamp"},
    "truncated": {"type": "boolean"},
    "refusals": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/Refusal"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"truncated": {"const": true}}},
      "then": {"properties": {"refusals": {"minItems": 100}}}
    }
  ],
  "$defs": {
    "UUID": {"type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
    "Timestamp": {"type": "string", "format": "date-time"},
    "SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "candidate_order_id", "snapshot_version", "request_sha256", "quote_sha256", "reason", "first_observed_at"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/UUID"},
        "candidate_order_id": {"$ref": "#/$defs/UUID"},
        "snapshot_version": {"type": "integer", "minimum": 1},
        "request_sha256": {"$ref": "#/$defs/SHA256"},
        "quote_sha256": {"$ref": "#/$defs/SHA256"},
        "reason": {"enum": [
          "instrument_not_allowed", "order_notional", "maximum_fee", "maximum_execution_cost", "held_quantity",
          "unresolved_order", "daily_turnover", "minimum_free_cash",
          "instrument_concentration", "group_concentration", "gross_exposure"
        ]},
        "first_observed_at": {"$ref": "#/$defs/Timestamp"}
      }
    }
  }
}
