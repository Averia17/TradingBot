{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen local research occurrence schedule 0.1",
  "description": "An occurrence uses the stable schedule ID and scheduled UTC instant as its durable job identity. Inputs for an accepted occurrence are immutable. Runtime checks cover duplicate instants, portfolio time, archive containment and digest, and the scheduling window.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schedule_id", "policy_version", "max_lateness_seconds", "occurrences"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "schedule_id": {"$ref": "research-job.schema.json#/$defs/Identifier"},
    "policy_version": {"$ref": "research-job.schema.json#/$defs/Identifier"},
    "max_lateness_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheduled_at", "portfolio", "requested_symbols", "data_manifest", "max_llm_calls"],
        "properties": {
          "scheduled_at": {"type": "string", "format": "date-time"},
          "portfolio": {"$ref": "portfolio.schema.json"},
          "requested_symbols": {"$ref": "research-job.schema.json#/$defs/JobRequest/properties/requested_symbols"},
          "data_manifest": {
            "$ref": "research-job.schema.json#/$defs/JobRequest/properties/data_manifest",
            "properties": {"ref": {"not": {"pattern": "(^|/)(\\.|\\.\\.)(/|$)|//|/$"}}}
          },
          "max_llm_calls": {"$ref": "research-job.schema.json#/$defs/JobRequest/properties/max_llm_calls"}
        }
      }
    }
  }
}
