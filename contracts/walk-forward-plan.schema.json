{
  "$defs": {
    "WalkForwardPlan": {
      "additionalProperties": false,
      "properties": {
        "experiment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "max_position_pct": {
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$",
          "type": "string"
        },
        "max_total_llm_calls": {
          "maximum": 2048,
          "minimum": 1,
          "type": "integer"
        },
        "policy_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "0.1"
          ]
        },
        "source_mode": {
          "enum": [
            "synthetic_fixture"
          ]
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/WalkForwardStep"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "source_mode",
        "experiment_id",
        "policy_version",
        "max_position_pct",
        "max_total_llm_calls",
        "steps"
      ],
      "title": "WalkForwardPlan",
      "type": "object"
    },
    "WalkForwardStep": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
          "type": "string"
        },
        "completed_at": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
          "type": "string"
        },
        "data_manifest": {
          "$ref": "#/$defs/_Manifest"
        },
        "max_llm_calls": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "requested_symbols": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9.]{0,11}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "as_of",
        "completed_at",
        "requested_symbols",
        "max_llm_calls",
        "data_manifest"
      ],
      "title": "WalkForwardStep",
      "type": "object"
    },
    "_Manifest": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "title": "_Manifest",
      "type": "object"
    }
  },
  "$ref": "#/$defs/WalkForwardPlan",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
