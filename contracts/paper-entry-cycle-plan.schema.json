{
  "$defs": {
    "ArchiveReference": {
      "additionalProperties": false,
      "description": "Reference shape shared with the research job's data_manifest field.",
      "properties": {
        "ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$",
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "title": "ArchiveReference",
      "type": "object"
    },
    "Occurrence": {
      "additionalProperties": false,
      "properties": {
        "scheduled_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Scheduled At",
          "type": "string"
        },
        "max_lateness_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Lateness Seconds",
          "type": "integer"
        },
        "marks": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "screening": {
          "$ref": "#/$defs/ArchiveReference"
        }
      },
      "required": [
        "scheduled_at",
        "max_lateness_seconds",
        "marks",
        "screening"
      ],
      "title": "Occurrence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "account_id": {
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$",
      "title": "Account Id",
      "type": "string"
    },
    "schedule_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Schedule Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/ArchiveReference"
    },
    "occurrences": {
      "items": {
        "$ref": "#/$defs/Occurrence"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Occurrences",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "account_id",
    "schedule_id",
    "policy",
    "occurrences"
  ],
  "title": "EntryCyclePlan",
  "type": "object"
}
