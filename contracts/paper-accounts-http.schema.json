{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingbot.local/contracts/paper-accounts-http.schema.json",
  "title": "Paper accounts internal HTTP v1",
  "$defs": {
    "ID": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
    "USD": {"$ref": "paper-account.schema.json#/$defs/USD"},
    "Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Instant": {"type": "string", "format": "date-time"},
    "DocumentBytes": {"type": "string", "contentEncoding": "base64", "minLength": 4, "maxLength": 349528},
    "Reservation": {
      "$ref": "paper-account.schema.json#/$defs/ReservationFields",
      "unevaluatedProperties": false
    },
    "Application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "account_id", "snapshot_version", "request_sha256"],
      "properties": {
        "job_id": {"$ref": "#/$defs/ID"},
        "account_id": {"$ref": "#/$defs/ID"},
        "snapshot_version": {"type": "integer", "minimum": 1},
        "request_sha256": {"$ref": "#/$defs/Digest"},
        "quote_base64": {"$ref": "#/$defs/DocumentBytes"},
        "reserve_before": {"$ref": "#/$defs/Instant"}
      }
    },
    "ApplicationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application"],
      "properties": {
        "application": {"$ref": "#/$defs/Application"},
        "order_id": {"$ref": "#/$defs/ID"},
        "result_base64": {"$ref": "#/$defs/DocumentBytes"}
      }
    },
    "ReserveApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "application"],
      "properties": {
        "order": {"$ref": "#/$defs/Reservation"},
        "application": {"$ref": "#/$defs/Application", "required": ["quote_base64", "reserve_before"]}
      }
    },
    "RecordApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "result_base64", "expires_at"],
      "properties": {
        "application": {"$ref": "#/$defs/Application"},
        "order_id": {"$ref": "#/$defs/ID"},
        "result_base64": {"$ref": "#/$defs/DocumentBytes"},
        "expires_at": {"$ref": "#/$defs/Instant"}
      }
    },
    "OrderWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "recorded"],
      "properties": {
        "order": {"$ref": "paper-account.schema.json#/$defs/OrderWithFills"},
        "recorded": {"type": "boolean"}
      }
    },
    "RiskRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id", "job_id", "decision_id", "candidate_order_id", "snapshot_version",
        "request_sha256", "quote_sha256", "reason", "evaluated_at", "reserve_before"
      ],
      "properties": {
        "account_id": {"$ref": "#/$defs/ID"},
        "job_id": {"$ref": "#/$defs/ID"},
        "decision_id": {"$ref": "#/$defs/ID"},
        "candidate_order_id": {"$ref": "#/$defs/ID"},
        "snapshot_version": {"type": "integer", "minimum": 1},
        "request_sha256": {"$ref": "#/$defs/Digest"},
        "quote_sha256": {"$ref": "#/$defs/Digest"},
        "reason": {
          "enum": [
            "instrument_not_allowed", "order_notional", "maximum_fee", "maximum_execution_cost",
            "held_quantity", "unresolved_order", "daily_turnover", "minimum_free_cash",
            "instrument_concentration", "group_concentration", "gross_exposure"
          ]
        },
        "evaluated_at": {"$ref": "#/$defs/Instant"},
        "reserve_before": {"$ref": "#/$defs/Instant"}
      }
    },
    "RiskActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "account_version", "day_utc", "settled_gross_usd", "has_unknown", "pending"],
      "properties": {
        "account_id": {"$ref": "#/$defs/ID"},
        "account_version": {"type": "integer", "minimum": 1},
        "day_utc": {"$ref": "#/$defs/Instant"},
        "settled_gross_usd": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,8})?$"},
        "has_unknown": {"type": "boolean"},
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instrument", "quantity_raw", "remaining_quantity_raw", "gross_usd"],
            "properties": {
              "instrument": {"$ref": "paper-account.schema.json#/$defs/Instrument"},
              "quantity_raw": {"$ref": "paper-account.schema.json#/$defs/PositiveRawQuantity"},
              "remaining_quantity_raw": {"$ref": "paper-account.schema.json#/$defs/RawQuantity"},
              "gross_usd": {"$ref": "#/$defs/USD"}
            }
          }
        }
      }
    },
    "Reconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_base64", "observation_sha256"],
      "properties": {
        "observation_base64": {"$ref": "#/$defs/DocumentBytes"},
        "observation_sha256": {"$ref": "#/$defs/Digest"}
      }
    }
  }
}
