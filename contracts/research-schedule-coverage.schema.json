{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingbot.local/research-schedule-coverage.schema.json",
  "title": "Declared research calendar coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "checked_at", "schedule_id", "schedule_sha256", "excluded_event_occurrences", "days"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "scope": { "const": "declared_research_calendar" },
    "checked_at": { "type": "string", "format": "date-time" },
    "schedule_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "schedule_sha256": { "$ref": "#/$defs/SHA256" },
    "excluded_event_occurrences": { "type": "integer", "minimum": 0, "maximum": 127 },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/Day" }
    }
  },
  "$defs": {
    "SHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_utc", "occurrences"],
      "properties": {
        "date_utc": { "type": "string", "format": "date" },
        "occurrences": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/Window" } }
      }
    },
    "Window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "scheduled_at", "accept_before", "expected_request_sha256", "submission_status"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "scheduled_at": { "type": "string", "format": "date-time" },
        "accept_before": { "type": "string", "format": "date-time" },
        "expected_request_sha256": { "$ref": "#/$defs/SHA256" },
        "submission_status": { "enum": ["not_due", "window_open", "observed_miss", "missing_evidence", "on_time", "early", "late", "conflict"] },
        "closed_window_observed_at": { "type": "string", "format": "date-time" },
        "conflict": { "enum": ["closed_window_evidence", "job_request_evidence", "job_state_evidence"] },
        "job": { "$ref": "#/$defs/Job" }
      },
      "allOf": [
        {
          "if": { "properties": { "submission_status": { "enum": ["on_time", "early", "late"] } } },
          "then": { "required": ["job"] },
          "else": { "not": { "required": ["job"] } }
        },
        {
          "if": { "properties": { "submission_status": { "const": "conflict" } } },
          "then": { "required": ["conflict"] },
          "else": { "not": { "required": ["conflict"] } }
        },
        {
          "if": { "properties": { "submission_status": { "const": "observed_miss" } } },
          "then": { "required": ["closed_window_observed_at"] }
        }
      ]
    },
    "Job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "status", "attempts", "permit_history_known", "durable_permits", "recorded_callbacks", "missing_callbacks", "invalid_callback_receipts"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["queued", "leased", "completed", "failed", "expired"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "lease_expires_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "permit_history_known": { "type": "boolean" },
        "durable_permits": { "type": "integer", "minimum": 0 },
        "recorded_callbacks": { "type": "integer", "minimum": 0 },
        "missing_callbacks": { "type": "integer", "minimum": 0 },
        "invalid_callback_receipts": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "leased" } } },
          "then": { "required": ["lease_expires_at"] },
          "else": { "not": { "required": ["lease_expires_at"] } }
        },
        {
          "if": { "properties": { "status": { "const": "completed" } } },
          "then": { "required": ["completed_at"] },
          "else": { "not": { "required": ["completed_at"] } }
        }
      ]
    }
  }
}
