{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable research export for offline replay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jobs"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "jobs": {
      "description": "Distinct jobs ordered by durable completed_at, then job_id. The export pins the original bytes and is not an execution request.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "attempt", "created_at", "completed_at", "request_base64", "request_sha256", "result_base64", "result_sha256"],
        "properties": {
          "job_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
          "created_at": {"$ref": "#/$defs/ReceiptTime"},
          "completed_at": {"$ref": "#/$defs/ReceiptTime"},
          "request_base64": {
            "$ref": "#/$defs/JsonBytes",
            "description": "Exact immutable research job request bytes. The decoded payload follows research-job.schema.json."
          },
          "request_sha256": {"$ref": "#/$defs/SHA256"},
          "result_base64": {
            "$ref": "#/$defs/JsonBytes",
            "description": "Exact durable result bytes. The decoded payload follows research-result.schema.json#/$defs/Result and contains no lease credential."
          },
          "result_sha256": {"$ref": "#/$defs/SHA256"}
        }
      }
    }
  },
  "$defs": {
    "ReceiptTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "JsonBytes": {
      "type": "string",
      "minLength": 4,
      "maxLength": 44739244,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "contentEncoding": "base64",
      "contentMediaType": "application/json"
    }
  }
}
