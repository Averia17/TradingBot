{
  "$defs": {
    "ArchiveReference": {
      "additionalProperties": false,
      "description": "Reference shape shared with the research job's data_manifest field.",
      "properties": {
        "ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$",
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "title": "ArchiveReference",
      "type": "object"
    },
    "ReviewEvent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "report",
            "news",
            "price",
            "liquidity",
            "policy",
            "review"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Provider",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "provider",
        "record_id"
      ],
      "title": "ReviewEvent",
      "type": "object"
    },
    "ReviewWindow": {
      "additionalProperties": false,
      "properties": {
        "opening_order_id": {
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Opening Order Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "As Of",
          "type": "string"
        },
        "release_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Release At",
          "type": "string"
        },
        "max_lateness_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Lateness Seconds",
          "type": "integer"
        },
        "data_manifest": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "marks": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "max_llm_calls": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Llm Calls",
          "type": "integer"
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewEvent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "opening_order_id",
        "as_of",
        "release_at",
        "max_lateness_seconds",
        "data_manifest",
        "marks",
        "max_llm_calls"
      ],
      "title": "ReviewWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "account_id": {
      "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Account Id",
      "type": "string"
    },
    "schedule_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Schedule Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/ArchiveReference"
    },
    "identity_registry": {
      "$ref": "#/$defs/ArchiveReference"
    },
    "quote_tape": {
      "$ref": "#/$defs/ArchiveReference"
    },
    "occurrences": {
      "items": {
        "$ref": "#/$defs/ReviewWindow"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Occurrences",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "account_id",
    "schedule_id",
    "policy",
    "identity_registry",
    "quote_tape",
    "occurrences"
  ],
  "title": "ReviewCyclePlan",
  "type": "object"
}
