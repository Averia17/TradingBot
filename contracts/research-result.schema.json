{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research job result HTTP protocols 0.1 and 0.2",
  "$ref": "#/$defs/CompleteRequest",
  "$defs": {
    "Reports": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["final_trade_decision"],
        "properties": {
          "market_report": {"$ref": "#/$defs/ReportText"},
          "fundamentals_report": {"$ref": "#/$defs/ReportText"},
          "news_report": {"$ref": "#/$defs/ReportText"},
          "sentiment_report": {"$ref": "#/$defs/ReportText"},
          "trader_investment_plan": {"$ref": "#/$defs/ReportText"},
          "final_trade_decision": {"$ref": "#/$defs/ReportText"}
        }
      }
    },
    "ReportText": {"type": "string", "pattern": "\\S"},
    "SyntheticMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mode", "llm_calls", "alpha_measured"],
      "properties": {
        "source_mode": {"const": "synthetic_fixture"},
        "llm_calls": {
          "type": "integer",
          "const": 0,
          "description": "The HTTP endpoint requires the JSON integer literal 0."
        },
        "alpha_measured": {"const": false}
      }
    },
    "OfflineMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mode", "alpha_measured", "intraday_pit_verified", "llm_calls", "input_tokens", "output_tokens", "missing_usage_calls", "usd_cost", "provenance"],
      "properties": {
        "source_mode": {"const": "tradingagents_offline"},
        "alpha_measured": {"const": false},
        "intraday_pit_verified": {"const": false},
        "llm_calls": {"type": "integer", "minimum": 1, "maximum": 64},
        "input_tokens": {"$ref": "#/$defs/TokenCount"},
        "output_tokens": {"$ref": "#/$defs/TokenCount"},
        "missing_usage_calls": {"type": "integer", "minimum": 0, "maximum": 64},
        "usd_cost": {"type": "null"},
        "provenance": {"$ref": "#/$defs/OfflineProvenance"}
      },
      "description": "The endpoint requires integer literals for usage, limits missing usage to observed calls, requires zero reported tokens when usage is missing for all calls, and checks the immutable job's call budget. This mode uses scripted models and does not measure market performance or billed charges."
    },
    "TokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "OfflineProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "attempt", "policy_version", "data_manifest", "worker_version", "upstream_version", "upstream_sha", "config_sha256", "model_id"],
      "properties": {
        "job_id": {"$ref": "research-job.schema.json#/$defs/UUID", "pattern": "^[0-9a-f-]+$"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "policy_version": {"$ref": "research-job.schema.json#/$defs/Identifier"},
        "data_manifest": {
          "type": "object",
          "required": ["ref", "sha256"],
          "additionalProperties": false,
          "properties": {
            "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "worker_version": {"$ref": "research-job.schema.json#/$defs/Identifier"},
        "upstream_version": {"$ref": "research-job.schema.json#/$defs/Identifier"},
        "upstream_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_id": {"const": "scripted-offline-v1"}
      },
      "description": "Job ID, attempt, policy and manifest must match the stored job and active lease."
    },
    "Result": {
      "type": "object",
      "required": ["result_schema_version", "batch", "reports", "metadata"],
      "properties": {
        "result_schema_version": {"enum": ["0.1", "0.2"]},
        "batch": {"$ref": "schema.json"},
        "reports": {"$ref": "#/$defs/Reports"},
        "metadata": {"type": "object"}
      },
      "oneOf": [
        {"properties": {"result_schema_version": {"const": "0.1"}, "metadata": {"$ref": "#/$defs/SyntheticMetadata"}}},
        {"properties": {"result_schema_version": {"const": "0.2"}, "metadata": {"$ref": "#/$defs/OfflineMetadata"}}}
      ]
    },
    "CompleteRequest": {
      "description": "The endpoint also validates the lease, bound job snapshot, requested symbols and report hashes. For new results the reported call count must match permits recorded for the active attempt.",
      "allOf": [{"$ref": "#/$defs/Result"}],
      "required": ["worker_id", "lease_token"],
      "properties": {
        "worker_id": {"$ref": "research-job.schema.json#/$defs/Identifier"},
        "lease_token": {"$ref": "research-job.schema.json#/$defs/UUID"}
      },
      "unevaluatedProperties": false
    },
    "CompleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status", "attempt", "completed_at", "result"],
      "properties": {
        "job_id": {"$ref": "research-job.schema.json#/$defs/UUID"},
        "status": {"const": "completed"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "completed_at": {"type": "string", "format": "date-time"},
        "result": {
          "allOf": [{"$ref": "#/$defs/Result"}],
          "unevaluatedProperties": false
        }
      }
    }
  }
}
