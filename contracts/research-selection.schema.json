{
  "$defs": {
    "ArchiveReference": {
      "additionalProperties": false,
      "description": "Reference shape shared with the research job's data_manifest field.",
      "properties": {
        "ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$",
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "title": "ArchiveReference",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$",
          "title": "Symbol",
          "type": "string"
        },
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "symbol",
        "allowed"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "IdentitySelectionRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Policy Version",
          "type": "string"
        },
        "portfolio": {
          "$ref": "#/$defs/PortfolioSnapshot"
        },
        "data_manifest": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/RosterCandidate"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "top_k": {
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "remaining_analysis_slots": {
          "maximum": 100,
          "minimum": 0,
          "title": "Remaining Analysis Slots",
          "type": "integer"
        },
        "calls_per_symbol": {
          "maximum": 63,
          "minimum": 1,
          "title": "Calls Per Symbol",
          "type": "integer"
        },
        "max_llm_calls": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Llm Calls",
          "type": "integer"
        },
        "roc_periods": {
          "maximum": 30,
          "minimum": 2,
          "title": "Roc Periods",
          "type": "integer"
        },
        "max_bar_age_seconds": {
          "maximum": 604800,
          "minimum": 1,
          "title": "Max Bar Age Seconds",
          "type": "integer"
        },
        "max_bar_gap_seconds": {
          "maximum": 604800,
          "minimum": 1,
          "title": "Max Bar Gap Seconds",
          "type": "integer"
        },
        "max_catalyst_age_seconds": {
          "maximum": 2592000,
          "minimum": 1,
          "title": "Max Catalyst Age Seconds",
          "type": "integer"
        },
        "min_bar_turnover_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "title": "Min Bar Turnover Usd",
          "type": "string"
        },
        "max_spread_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Spread Bps",
          "type": "integer"
        },
        "universe_provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Universe Provider",
          "type": "string"
        },
        "identity_registry": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "analysis_mode": {
          "anyOf": [
            {
              "const": "prepared_provider",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Mode"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "policy_version",
        "portfolio",
        "data_manifest",
        "candidates",
        "top_k",
        "remaining_analysis_slots",
        "calls_per_symbol",
        "max_llm_calls",
        "roc_periods",
        "max_bar_age_seconds",
        "max_bar_gap_seconds",
        "max_catalyst_age_seconds",
        "min_bar_turnover_usd",
        "max_spread_bps",
        "universe_provider",
        "identity_registry",
        "analysis_mode"
      ],
      "title": "IdentitySelectionRequest",
      "type": "object"
    },
    "PortfolioSnapshot": {
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "cash_asset": {
          "default": "USDC",
          "enum": [
            "USDC",
            "USD"
          ],
          "title": "Cash Asset",
          "type": "string"
        },
        "cash_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "title": "Cash Usd",
          "type": "string"
        },
        "reserved_cash_usd": {
          "default": "0",
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "title": "Reserved Cash Usd",
          "type": "string"
        },
        "max_position_pct": {
          "default": "0.25",
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "title": "Max Position Pct",
          "type": "string"
        },
        "positions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Position"
          },
          "title": "Positions",
          "type": "array"
        }
      },
      "required": [
        "snapshot_id",
        "as_of",
        "currency",
        "cash_asset",
        "cash_usd",
        "reserved_cash_usd",
        "max_position_pct",
        "positions"
      ],
      "title": "PortfolioSnapshot",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$",
          "title": "Symbol",
          "type": "string"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "title": "Quantity",
          "type": "string"
        },
        "mark_price_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "title": "Mark Price Usd",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "instrument_id",
        "quantity",
        "mark_price_usd"
      ],
      "title": "Position",
      "type": "object"
    },
    "RosterCandidate": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$",
          "title": "Symbol",
          "type": "string"
        },
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "security_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Security Id",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "allowed",
        "security_id"
      ],
      "title": "RosterCandidate",
      "type": "object"
    },
    "RosterSelectionRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Policy Version",
          "type": "string"
        },
        "portfolio": {
          "$ref": "#/$defs/PortfolioSnapshot"
        },
        "data_manifest": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/RosterCandidate"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "top_k": {
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "remaining_analysis_slots": {
          "maximum": 100,
          "minimum": 0,
          "title": "Remaining Analysis Slots",
          "type": "integer"
        },
        "calls_per_symbol": {
          "maximum": 63,
          "minimum": 1,
          "title": "Calls Per Symbol",
          "type": "integer"
        },
        "max_llm_calls": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Llm Calls",
          "type": "integer"
        },
        "roc_periods": {
          "maximum": 30,
          "minimum": 2,
          "title": "Roc Periods",
          "type": "integer"
        },
        "max_bar_age_seconds": {
          "maximum": 604800,
          "minimum": 1,
          "title": "Max Bar Age Seconds",
          "type": "integer"
        },
        "max_bar_gap_seconds": {
          "maximum": 604800,
          "minimum": 1,
          "title": "Max Bar Gap Seconds",
          "type": "integer"
        },
        "max_catalyst_age_seconds": {
          "maximum": 2592000,
          "minimum": 1,
          "title": "Max Catalyst Age Seconds",
          "type": "integer"
        },
        "min_bar_turnover_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "title": "Min Bar Turnover Usd",
          "type": "string"
        },
        "max_spread_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Spread Bps",
          "type": "integer"
        },
        "universe_provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Universe Provider",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "policy_version",
        "portfolio",
        "data_manifest",
        "candidates",
        "top_k",
        "remaining_analysis_slots",
        "calls_per_symbol",
        "max_llm_calls",
        "roc_periods",
        "max_bar_age_seconds",
        "max_bar_gap_seconds",
        "max_catalyst_age_seconds",
        "min_bar_turnover_usd",
        "max_spread_bps",
        "universe_provider"
      ],
      "title": "RosterSelectionRequest",
      "type": "object"
    },
    "SelectionRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Policy Version",
          "type": "string"
        },
        "portfolio": {
          "$ref": "#/$defs/PortfolioSnapshot"
        },
        "data_manifest": {
          "$ref": "#/$defs/ArchiveReference"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "top_k": {
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "remaining_analysis_slots": {
          "maximum": 100,
          "minimum": 0,
          "title": "Remaining Analysis Slots",
          "type": "integer"
        },
        "calls_per_symbol": {
          "maximum": 63,
          "minimum": 1,
          "title": "Calls Per Symbol",
          "type": "integer"
        },
        "max_llm_calls": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Llm Calls",
          "type": "integer"
        },
        "roc_periods": {
          "maximum": 30,
          "minimum": 2,
          "title": "Roc Periods",
          "type": "integer"
        },
        "max_bar_age_seconds": {
          "maximum": 604800,
          "minimum": 1,
          "title": "Max Bar Age Seconds",
          "type": "integer"
        },
        "max_bar_gap_seconds": {
          "maximum": 604800,
          "minimum": 1,
          "title": "Max Bar Gap Seconds",
          "type": "integer"
        },
        "max_catalyst_age_seconds": {
          "maximum": 2592000,
          "minimum": 1,
          "title": "Max Catalyst Age Seconds",
          "type": "integer"
        },
        "min_bar_turnover_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
          "title": "Min Bar Turnover Usd",
          "type": "string"
        },
        "max_spread_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Spread Bps",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "policy_version",
        "portfolio",
        "data_manifest",
        "candidates",
        "top_k",
        "remaining_analysis_slots",
        "calls_per_symbol",
        "max_llm_calls",
        "roc_periods",
        "max_bar_age_seconds",
        "max_bar_gap_seconds",
        "max_catalyst_age_seconds",
        "min_bar_turnover_usd",
        "max_spread_bps"
      ],
      "title": "SelectionRequest",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "0.1": "#/$defs/SelectionRequest",
      "0.2": "#/$defs/RosterSelectionRequest",
      "0.3": "#/$defs/IdentitySelectionRequest"
    },
    "propertyName": "schema_version"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SelectionRequest"
    },
    {
      "$ref": "#/$defs/RosterSelectionRequest"
    },
    {
      "$ref": "#/$defs/IdentitySelectionRequest"
    }
  ]
}
