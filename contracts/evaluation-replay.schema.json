{
  "$defs": {
    "CashDividend": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "type": "string"
        },
        "cash_per_share_usd": {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        "entitlement_at": {
          "format": "date-time",
          "type": "string"
        },
        "paid_at": {
          "format": "date-time",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.]{0,11}$",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "symbol",
        "available_at",
        "entitlement_at",
        "paid_at",
        "cash_per_share_usd"
      ],
      "title": "CashDividend",
      "type": "object"
    },
    "Order": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "intent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "quantity": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "ready_at": {
          "format": "date-time",
          "type": "string"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.]{0,11}$",
          "type": "string"
        }
      },
      "required": [
        "intent_id",
        "symbol",
        "side",
        "quantity",
        "ready_at",
        "expires_at"
      ],
      "title": "Order",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "ask_size": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "ask_usd": {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "type": "string"
        },
        "bid_size": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "bid_usd": {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.]{0,11}$",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "observed_at",
        "available_at",
        "bid_usd",
        "ask_usd",
        "bid_size",
        "ask_size"
      ],
      "title": "Quote",
      "type": "object"
    },
    "Replay": {
      "additionalProperties": false,
      "properties": {
        "cash_dividends": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CashDividend"
          },
          "type": "array"
        },
        "commission_bps": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "orders": {
          "items": {
            "$ref": "#/$defs/Order"
          },
          "type": "array"
        },
        "quotes": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "minItems": 1,
          "type": "array"
        },
        "schema_version": {
          "enum": [
            "0.1"
          ]
        },
        "source_mode": {
          "enum": [
            "synthetic_fixture"
          ]
        },
        "starting_cash_usd": {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        "stock_splits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StockSplit"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "source_mode",
        "starting_cash_usd",
        "commission_bps",
        "quotes",
        "orders"
      ],
      "title": "Replay",
      "type": "object"
    },
    "StockSplit": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "type": "string"
        },
        "effective_at": {
          "format": "date-time",
          "type": "string"
        },
        "new_shares": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "old_shares": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9.]{0,11}$",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "symbol",
        "available_at",
        "effective_at",
        "new_shares",
        "old_shares"
      ],
      "title": "StockSplit",
      "type": "object"
    }
  },
  "$ref": "#/$defs/Replay",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
