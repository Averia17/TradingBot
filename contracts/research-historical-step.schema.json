{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic historical research step request",
  "description": "This request supplies a simulated completion time and a job with a locally ingested synthetic archive. Legacy jobs produce research result 0.2. Identity-bound jobs require an independent CLI registry pin and produce research result 0.3 with the selected identities and projected snapshot digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["job", "completed_at"],
  "properties": {
    "job": {
      "allOf": [
        {"$ref": "research-job.schema.json#/$defs/JobRequest"},
        {"properties": {"portfolio": {"properties": {"as_of": {"$ref": "#/$defs/Cutoff"}}}}}
      ]
    },
    "variant": {
      "enum": ["full_graph", "no_memory", "single_analyst", "factual_reflection"],
      "default": "full_graph"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(?:Z|\\+00:00)$"
    }
  },
  "$defs": {
    "Cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
