{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local paper application contracts",
  "$ref": "#/$defs/Request",
  "$defs": {
    "Identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$"},
    "CapBPS": {"type": "integer", "minimum": 1, "maximum": 10000},
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "max_order_usd", "min_free_cash_usd", "max_position_bps", "max_group_bps", "max_gross_bps", "max_fee_bps", "max_mark_age_seconds", "instruments"],
      "properties": {
        "policy_version": {"$ref": "#/$defs/Identifier"},
        "max_order_usd": {"$ref": "paper-account.schema.json#/$defs/USD"},
        "min_free_cash_usd": {"$ref": "paper-account.schema.json#/$defs/USD"},
        "max_position_bps": {"$ref": "#/$defs/CapBPS"},
        "max_group_bps": {"$ref": "#/$defs/CapBPS"},
        "max_gross_bps": {"$ref": "#/$defs/CapBPS"},
        "max_fee_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_execution_cost_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_mark_age_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_daily_turnover_usd": {"$ref": "paper-account.schema.json#/$defs/USD"},
        "block_new_buys_on_unknown": {"type": "boolean"},
        "instruments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instrument", "symbol", "group"],
            "properties": {
              "instrument": {"$ref": "paper-account.schema.json#/$defs/Instrument"},
              "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$"},
              "group": {"$ref": "#/$defs/Identifier"}
            }
          }
        }
      }
    },
    "Marks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument", "price_usd", "at", "available_at"],
        "properties": {
          "instrument": {"$ref": "paper-account.schema.json#/$defs/Instrument"},
          "price_usd": {"$ref": "paper-account.schema.json#/$defs/USD"},
          "at": {"type": "string", "format": "date-time"},
          "available_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "SnapshotContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "snapshot_version", "policy", "marks"],
      "properties": {
        "account_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "snapshot_version": {"type": "integer", "minimum": 1},
        "policy": {"$ref": "#/$defs/Policy"},
        "marks": {"$ref": "#/$defs/Marks"}
      }
    },
    "SnapshotBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_context", "portfolio"],
      "properties": {
        "snapshot_context": {"$ref": "#/$defs/SnapshotContext"},
        "portfolio": {"$ref": "portfolio.schema.json"}
      }
    },
    "OwnerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_registry", "quote_tape"],
      "properties": {
        "identity_registry": {"$ref": "research-job.schema.json#/$defs/PinnedLocalReference"},
        "quote_tape": {"$ref": "research-job.schema.json#/$defs/PinnedLocalReference"}
      }
    },
    "ReviewIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_registry", "quote_tape", "projected_snapshot_sha256"],
      "properties": {
        "identity_registry": {"$ref": "research-job.schema.json#/$defs/PinnedLocalReference"},
        "quote_tape": {"$ref": "research-job.schema.json#/$defs/PinnedLocalReference"},
        "projected_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ReviewOrigin": {
      "description": "Immutable opening order and application proof retained by a stable review approval.",
      "type": "object",
      "additionalProperties": false,
      "required": ["opening_order_id", "opening_application_sha256"],
      "properties": {
        "opening_order_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "opening_application_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "IdentityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_registry", "quote_tape", "projected_snapshot_sha256", "security_bindings"],
      "properties": {
        "identity_registry": {"$ref": "research-job.schema.json#/$defs/PinnedLocalReference"},
        "quote_tape": {"$ref": "research-job.schema.json#/$defs/PinnedLocalReference"},
        "projected_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "security_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "security_id", "instrument"],
            "properties": {
              "symbol": {"$ref": "research-job.schema.json#/$defs/JobRequest/properties/requested_symbols/items"},
              "security_id": {"$ref": "#/$defs/Identifier"},
              "instrument": {"$ref": "paper-account.schema.json#/$defs/Instrument"},
              "expires_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "ReviewScheduleRequest": {
      "description": "Submit a due paper thesis review to the ordinary research queue. If portfolio is omitted, derive the snapshot at the database clock and reuse the first accepted input on an identical configuration replay.",
      "type": "object",
      "additionalProperties": false,
      "required": ["review_schedule_schema_version", "opening_order_id", "snapshot_context", "data_manifest", "max_llm_calls"],
      "properties": {
        "review_schedule_schema_version": {"enum": ["0.1", "0.2"]},
        "opening_order_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "snapshot_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_id", "policy", "marks"],
          "properties": {
            "account_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
            "snapshot_version": {"type": "integer", "minimum": 0},
            "policy": {"$ref": "#/$defs/Policy", "properties": {"policy_version": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}},
            "marks": {"$ref": "#/$defs/Marks"}
          }
        },
        "portfolio": {"$ref": "portfolio.schema.json"},
        "data_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "sha256"],
          "properties": {
            "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$", "not": {"pattern": "(^|/)([.]|[.][.])(/|$)|//|/$"}},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "max_llm_calls": {"type": "integer", "minimum": 1, "maximum": 64},
        "identity_binding": {"$ref": "#/$defs/ReviewIdentity"},
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "provider", "record_id"],
          "properties": {
            "kind": {"enum": ["report", "news", "price", "liquidity", "policy", "review"]},
            "provider": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
            "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
          }
        }
      },
      "if": {"required": ["portfolio"]},
      "then": {"properties": {"snapshot_context": {"required": ["snapshot_version"], "properties": {"snapshot_version": {"minimum": 1}}}}},
      "else": {"properties": {"snapshot_context": {"properties": {"snapshot_version": {"const": 0}}}}},
      "allOf": [{
        "if": {"properties": {"review_schedule_schema_version": {"const": "0.2"}}},
        "then": {"required": ["identity_binding", "portfolio"]},
        "else": {"not": {"required": ["identity_binding"]}}
      }]
    },
    "ReviewScheduleReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_schedule_schema_version", "status", "created"],
      "properties": {
        "review_schedule_schema_version": {"enum": ["0.1", "0.2"]},
        "status": {"enum": ["not_due", "missed", "already_scheduled", "queued", "leased", "failed", "expired", "completed"]},
        "created": {"type": "boolean"},
        "trigger": {"$ref": "paper-thesis.schema.json#/$defs/Trigger"},
        "job_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "created_at": {"type": "string", "format": "date-time"},
        "snapshot": {"$ref": "#/$defs/SnapshotBundle"}
      },
      "if": {"properties": {"status": {"enum": ["not_due", "missed"]}}},
      "then": {
        "properties": {"created": {"const": false}},
        "not": {"anyOf": [{"required": ["trigger"]}, {"required": ["job_id"]}, {"required": ["created_at"]}, {"required": ["snapshot"]}]},
        "if": {"properties": {"status": {"const": "missed"}}},
        "then": {"properties": {"review_schedule_schema_version": {"const": "0.2"}}}
      },
      "else": {
        "if": {"properties": {"status": {"const": "already_scheduled"}}},
        "then": {
          "properties": {"review_schedule_schema_version": {"const": "0.2"}, "created": {"const": false}},
          "required": ["job_id", "created_at"],
          "not": {"anyOf": [{"required": ["trigger"]}, {"required": ["snapshot"]}]}
        },
        "else": {"required": ["trigger", "job_id", "created_at", "snapshot"]}
      }
    },
    "EntryScheduleRequest": {
      "description": "One owner-authorized calendar occurrence over a SHA-256-pinned selection receipt. Account ID, schedule ID and scheduled UTC instant determine the durable job ID.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_schedule_schema_version", "schedule_id", "scheduled_at", "max_lateness_seconds", "max_job_llm_calls", "snapshot_context", "selection_sha256"],
      "properties": {
        "entry_schedule_schema_version": {"enum": ["0.1", "0.2"]},
        "schedule_id": {"$ref": "research-job.schema.json#/$defs/Identifier"},
        "scheduled_at": {"type": "string", "format": "date-time"},
        "max_lateness_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_job_llm_calls": {"type": "integer", "minimum": 1, "maximum": 64},
        "snapshot_context": {"$ref": "#/$defs/SnapshotContext"},
        "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "identity_binding": {"$ref": "#/$defs/OwnerIdentity"}
      },
      "if": {"properties": {"entry_schedule_schema_version": {"const": "0.2"}}},
      "then": {"required": ["identity_binding"]},
      "else": {"not": {"required": ["identity_binding"]}}
    },
    "EntrySelection": {
      "description": "Selection receipt as emitted by tradingbot.selection. Candidate diagnostics and the suggested job ID are informational.",
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_schema_version", "source_mode", "snapshot_sha256", "stockstats_version", "job", "candidates"],
      "properties": {
        "selection_schema_version": {"enum": ["0.1", "0.2"]},
        "source_mode": {"enum": ["synthetic_fixture", "local_archive"]},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stockstats_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "job": {},
        "candidates": {"type": "array", "maxItems": 100, "items": {"type": "object"}}
      },
      "if": {"properties": {"selection_schema_version": {"const": "0.2"}}},
      "then": {"properties": {"job": {"anyOf": [{"$ref": "research-job.schema.json#/$defs/IdentityJobRequest"}, {"type": "null"}]}}},
      "else": {"properties": {"job": {"anyOf": [{"$ref": "research-job.schema.json#/$defs/JobRequest"}, {"type": "null"}]}}}
    },
    "EntryScheduleReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_schedule_schema_version", "status", "created"],
      "properties": {
        "entry_schedule_schema_version": {"enum": ["0.1", "0.2"]},
        "status": {"enum": ["not_due", "not_selected", "missed", "queued", "leased", "failed", "expired", "completed"]},
        "created": {"type": "boolean"},
        "job_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "if": {"properties": {"status": {"enum": ["not_due", "not_selected", "missed"]}}},
      "then": {
        "properties": {"created": {"const": false}},
        "not": {"anyOf": [{"required": ["job_id"]}, {"required": ["created_at"]}]}
      },
      "else": {"required": ["job_id", "created_at"]}
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_apply_schema_version", "job_id", "snapshot_context"],
      "properties": {
        "paper_apply_schema_version": {"enum": ["0.1", "0.2"]},
        "job_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "snapshot_context": {"$ref": "#/$defs/SnapshotContext"},
        "entry_schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_origin": {"$ref": "#/$defs/ReviewOrigin"},
        "intent": {"anyOf": [{"$ref": "paper-replay.schema.json#/$defs/Intent"}, {"type": "null"}]},
        "identity_binding": {"$ref": "#/$defs/IdentityBinding"}
      },
      "if": {"properties": {"paper_apply_schema_version": {"const": "0.2"}}},
      "then": {
        "required": ["identity_binding"],
        "not": {"required": ["intent"]},
        "oneOf": [
          {"required": ["entry_schedule_sha256"], "not": {"anyOf": [{"required": ["review_origin"]}, {"required": ["review_schedule_sha256"]}]}},
          {"required": ["review_schedule_sha256"], "not": {"required": ["entry_schedule_sha256"]}}
        ]
      },
      "else": {"not": {"anyOf": [{"required": ["identity_binding"]}, {"required": ["review_schedule_sha256"]}, {"required": ["review_origin"]}]}}
    },
    "QuotePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_quote_pin_schema_version", "job_id", "quote"],
      "properties": {
        "paper_quote_pin_schema_version": {"const": "0.1"},
        "job_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "quote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "sha256"],
          "properties": {
            "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$", "not": {"pattern": "(^|/)([.]|[.][.])(/|$)|//|/$"}},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "FollowReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_follow_schema_version", "job_id", "status"],
      "properties": {
        "paper_follow_schema_version": {"const": "0.1"},
        "job_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "status": {"enum": ["awaiting_research", "awaiting_quote", "awaiting_recovery", "quote_expired", "snapshot_stale", "research_failed", "research_expired", "expired", "hold", "applied"]},
        "application": {"$ref": "#/$defs/Result"}
      },
      "if": {"properties": {"status": {"enum": ["hold", "applied"]}}},
      "then": {"required": ["application"]},
      "else": {"not": {"required": ["application"]}}
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_apply_schema_version", "job_id", "status"],
      "properties": {
        "paper_apply_schema_version": {"const": "0.1"},
        "job_id": {"$ref": "paper-account.schema.json#/$defs/AccountID"},
        "status": {"enum": ["hold", "applied"]},
        "execution": {"$ref": "paper-replay.schema.json#/$defs/Result"}
      },
      "if": {"properties": {"status": {"const": "applied"}}},
      "then": {"required": ["execution"]},
      "else": {"not": {"required": ["execution"]}}
    }
  }
}
